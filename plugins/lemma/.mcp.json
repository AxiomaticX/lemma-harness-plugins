{
  "mcpServers": {
    "handoff": {
      "command": "uv",
      "args": ["run", "--frozen", "--no-dev", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}/server", "lemma-mcp"],
      "env": {
        "LEMMA_OPEN_BROWSER": "${user_config.open_browser}",
        "LEMMA_DEFAULT_MODEL": "${user_config.default_model}",
        "LEMMA_DEFAULT_MACHINE": "${user_config.default_machine}",
        "LEMMA_MAX_TOOL_OUTPUT_CHARS": "${user_config.max_tool_output_chars}"
      }
    }
  }
}
